#!/bin/bash

# Usage:
# Put this at the top of your file:
# exec 1> >(bulog -n NameOfYourProgram) 2>&1
# Or this:
# exec 1> >(bulog -n "$(basename "$0")") 2>&1
# Or just do this:
# bulog -n NameOfYourProgram -l {DEBUG, INFO, WARN, ERROR} -m "Your Message"

# NOTE:
# When piping, provide your own severity in FULL CAPS:
# exec 1> >(bulog -n "$(basename "$0")") 2>&1
# echo "INFO Test echo command"

# Examples:
# bulog -m "Message without a name"
# 2026-03-12T15:33:40,760241533+01:00 info bulog: Message without a name

# bulog -n testname -m "Message with a name"
# 2026-03-12T15:33:40,767525171+01:00 info testname: Message with a name

# bulog -n testname -l warn -m "Message with name and level"
# 2026-03-12T15:33:40,775964817+01:00 warn testname: Message with name and level

# exec 1> >(bulog -n "$(basename "$0")") 2>&1
# echo "DEBUG Test echo command"
# 2026-03-12T15:33:40,786257242+01:00 info test.sh: DEBUG Test echo command

while getopts "n:m:l:" opt; do
    case ${opt} in
    n)
        NAME=$OPTARG
        ;;
    m)
        MESSAGE=$OPTARG
        ;;
    l)
        LEVEL=$OPTARG
        ;;
    \?)
        echo "Invalid option: -$OPTARG" >&2
        exit 1
        ;;
    :)
        echo "Option -$OPTARG requires an argument." >&2
        exit 1
        ;;
    esac
done

# Fallback to the name of this script
if [ -z "$NAME" ]; then
    NAME=$(basename "$0")
fi

mkdir -p /home/booster/bu
chown booster:booster /home/booster/bu

LOGFILE=/home/booster/bu/bu.log
chown booster:booster $LOGFILE

write_log() {
    local level
    if [ -n "$3" ]; then
        level="$3"
    elif [[ $2 == *"ERROR"* ]]; then
        level=error
    elif [[ $2 == *"WARN"* ]]; then
        level=warn
    elif [[ $2 == *"INFO"* ]]; then
        level=info
    elif [[ $2 == *"DEBUG"* ]]; then
        level=debug
    else
        level=info # Default
    fi
    echo "$(date --iso-8601=ns) "${level,,}" $1: $2" >>$LOGFILE
}

# If MESSAGE is set, write MESSAGE, else read from stdin
if [ -n "$MESSAGE" ]; then
    write_log "$NAME" "$MESSAGE" "$LEVEL"
else
    while IFS= read -r LINE; do
        write_log "$NAME" "$LINE"
    done
fi

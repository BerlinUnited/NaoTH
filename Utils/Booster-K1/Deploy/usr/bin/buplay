#!/bin/bash

NAME=buplay source buloginit

while getopts "m:f:" opt; do
    case ${opt} in
    m)
        MESSAGE=$OPTARG
        ;;
    f)
        FILE=$OPTARG
        ;;
    \?)
        warn "Invalid option: -$OPTARG"
        exit 1
        ;;
    :)
        warn "Option -$OPTARG requires an argument."
        exit 1
        ;;
    esac
done

# Exit early and just play the file
if [ -n "$FILE" ]; then
    aplay -D sysdefault:CARD=Device "$FILE"
    exit 0
fi

if [ -n "$MESSAGE" ]; then
    error "Not supported yet"
    exit 1

    # Path is important for de_DE-thorsten-high and .venv
    # cd /home/booster/bu/audio
    # . .venv/bin/activate
    # python -m piper -m de_DE-thorsten-high -f /home/booster/bu/tmp/tmp.wav -- "$MESSAGE"
    # coloredlogs==15.0.1
    # flatbuffers==25.12.19
    # humanfriendly==10.0
    # mpmath==1.3.0
    # numpy==2.2.6
    # onnxruntime==1.23.2
    # packaging==26.0
    # pathvalidate==3.3.1
    # piper-tts==1.4.1
    # protobuf==7.34.0
    # sympy==1.14.0

    #     cd /home/booster/naoth/audio
    #     python -m venv .venv
    #     . .venv/bin/activate
    #     pip install -r requirements.txt

    # aplay -D sysdefault:CARD=Device /home/booster/bu/tmp/tmp.wav
    # exit 0
fi

error "Neither -m for -f provided"
exit 1

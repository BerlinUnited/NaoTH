#!/bin/bash

exec 1> >(exec bulog -n "$NAME"'[stdout]') 2> >(exec bulog -n "$NAME"'[stderr]')
# alias debug='echo DEBUG '
# alias info='echo INFO '
# alias warn='>&2 echo WARN '
# alias error='>&2 echo ERROR '
debug() {
    echo "DEBUG $*"
}

info() {
    echo "INFO $*"
}

warn() {
    >&2 echo "WARN $*"
}

error() {
    >&2 echo "ERROR $*"
}

#!/bin/bash

# Heinrich says it was only used for remote games in 2021 - it has nothing to do with our log stick
# Update: we now use this script to actually mount our log stick!

# print all commands just in case
set -x # echo on

# redirect all the output to the logger
exec 1> >(logger -s -t mount_logstick) 2>&1

# assure mount point exists
mkdir -p /mnt/logstick

# mount usb drive
shopt -s nocaseglob # also match any of {l,L}x{o,O}x{g,G}x{s,S}x{t,T}x{i,I}x{c,C}x{k,K}
# (udev only calls this script for *LOGSTICK* or *logstick* thought)
sudo mount "$(echo /dev/disk/by-label/*logstick* | head -1)" /mnt/logstick

# check success
if [ $? -ne 0 ]; then
    logger -t mount_logstick "ERROR: usb unknown mount error"
    su nao -c "/usr/bin/paplay /home/nao/naoqi/Media/error_usb_unknown_mount_error.wav"
    exit 1
fi

chown --recursive nao:nao /mnt/logstick

# don't fail if it does not exist
rm /home/nao/log_data || true

ln -sfn /mnt/logstick /home/nao/log_data

chown nao:nao /home/nao/log_data

su nao -c "/usr/bin/paplay /home/nao/naoqi/Media/usb_start.wav"

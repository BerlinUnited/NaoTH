#!/bin/bash

# print all commands just in case
# set -x # echo on

# redirect all the output to the logger
exec 1> >(logger -s -t mount_logstick) 2>&1

echo "please type password for umount:"

sudo umount /mnt/logstick

# check success
if [ $? -ne 0 ]; then
    logger -t mount_logstick "ERROR: usb unknown unmount error"
    su nao -c "/usr/bin/paplay /home/nao/naoqi/Media/error_usb_unknown_mount_error.wav"
    exit 1
fi

# don't fail if it does not exist
rm /home/nao/log_data || true

# assure local data dir exists
mkdir -p /home/nao/log_data_local

ln -sfn /home/nao/log_data_local /home/nao/log_data

chown nao:nao /home/nao/log_data

su nao -c "/usr/bin/paplay /home/nao/naoqi/Media/usb_stop.wav"

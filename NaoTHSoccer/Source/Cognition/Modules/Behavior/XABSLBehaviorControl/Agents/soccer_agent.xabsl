/** The root option of the soccer behavior */
option soccer_agent {

  common decision
  {
    if (game.phase == penaltyshoot)
        goto penalty_shootout;
    else if (game.phase == normal)
        goto normal_soccer;
    else if(game.type == game_1v1)
        goto game_1v1;
  }
  
  initial state idle {
    decision {
      else
        goto normal_soccer;
    }
    action {}
  }

  state normal_soccer {
    action {
      roles_spl_play_soccer();
    }
  }

  state penalty_shootout {
    action {
      penalty_agent();
    }
  }

  state game_1v1 {
    action {
      roles_spl_play_soccer();
    }
  }
}
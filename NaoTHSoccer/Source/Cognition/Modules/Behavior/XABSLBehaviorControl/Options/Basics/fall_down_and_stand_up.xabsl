option fall_down_and_stand_up
{
  initial state idle
  {
    decision
    {
      // HACK: no standup in init
      if(executed_motion.type == init)
        stay;
      else if(abs(value=sensor.inertial.y)>25 || abs(value=sensor.inertial.x)>20)
      {
        if(sensor.inertial.y > 0)
          goto falling_front;
        else
          goto falling_back;
//          goto falling;
      }
      else
        stay;
    }      
    action
    {
      //HACK: body.ready_to_walk = true has to be set outside
      //body.ready_to_walk = true;
      // remember the arms position for the case the robot falls backwards
      // (used by stand up)
      arm.control_mode_before_fall = arm.control_mode;
    }
  }

  state falling_front
  {
    decision
    {
      if (executed_motion.type == save_fall_front)
        goto falling_front_wait;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      motion.execute_immediately = true;
      motion.type = save_fall_front;
      arm.react_to_collision = false;

      // enable only for special occasions
      //sound.request = (state_time < 100)?weeeee:off;
    }
  }

  state falling_front_wait
  {
    decision
    {
      if (state_time > 2000 && executed_motion.type == falling)
        goto stand_up;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      //motion.execute_immediately = true;
      motion.type = falling;
      arm.react_to_collision = false;

      // enable only for special occasions
      //sound.request = (state_time < 100)?weeeee:off;
    }
  }

  state falling_back
  {
    decision
    {
      if (executed_motion.type == save_fall_back)
        goto falling_back_wait;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      motion.execute_immediately = true;
      motion.type = save_fall_back;
      arm.react_to_collision = false;

      // enable only for special occasions
      //sound.request = (state_time < 100)?weeeee:off;
    }
  }

  state falling_back_wait
  {
    decision
    {
      if (state_time > 2000 && executed_motion.type == falling)
        goto stand_up;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      //motion.execute_immediately = true;
      motion.type = falling;
      arm.react_to_collision = false;

      // enable only for special occasions
      //sound.request = (state_time < 100)?weeeee:off;
    }
  }
  
  state falling
  {
    decision
    {
      if (fall_down_state != upright)
        goto wait_before_stand_up;
      else if (state_time > 2000)
        goto stand_up;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      motion.execute_immediately = true;
      motion.type = falling;
      arm.react_to_collision = false;

      // enable only for special occasions
      //sound.request = (state_time < 100)?weeeee:off;
    }
  }

  state wait_before_stand_up
  {
    decision
    {
      if(fall_down_state == undefined)
        stay;
      else if (state_time > 500)
        goto stand_up;
      else 
        stay;
    }
    action
    {
      body.ready_to_walk = false;
      motion.execute_immediately = true;
      motion.type = falling;
      arm.react_to_collision = false;
    }
  }

  state stand_up
  {
    decision
    {
      if(action_done)
        goto stand;
      else
        stay;
    }
    action 
    {
      arm.react_to_collision = false;
      body.ready_to_walk = false;
      motion.execute_immediately = false;
      
      stand_up();
    }
  }

  state stand
  {
    decision
    {
      if(executed_motion.type == stand)
        goto wait_for_completed_stand;
      else 
        stay;
    }      
    action
    {
      body.ready_to_walk = false;
      
      motion.type=stand;
      head.control_mode = look_straight_ahead;
      arm.control_mode = normal;
    }
  }

  state wait_for_completed_stand
  {
    decision
    {
      if(executed_motion.target_reached)
        goto idle;
      else
        stay;
    }

    action
    {
      arm.react_to_collision = false;
      body.ready_to_walk = false;
      
      motion.type=stand;
      head.control_mode = look_straight_ahead;
      arm.control_mode = normal;
    }
  }
  
  
}
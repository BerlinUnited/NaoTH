/**
 * This is the simplest free-kick and kick-in behavior.
 * If its our free-kick, we continue our normal play;
 * Otherwise we search for the ball and if we found the ball, we move back from it.
 */
option free_kick_simple
{  
  initial state decide
  {
    decision {
      if(game.own_kickoff)
        goto own_free_kick;
      else
        if (!ball.know_where_itis)
          if (ball.preview.y > 0)
            goto opp_free_kick_search_ball_left;
          else
            goto opp_free_kick_search_ball_right;
        else
          goto opp_free_kick_go_to_strategy_point;
    }
    action {
    }
  }
  
  state opp_free_kick_search_ball_left
  {
    decision {
      if(game.own_kickoff)
        goto own_free_kick;
      else if (ball.know_where_itis)
        goto opp_free_kick_go_to_strategy_point;
      else
        stay;
    }
    action {
      search_ball_turning(search_direction = left);
    }
  }

  state opp_free_kick_search_ball_right
  {
    decision {
      if(game.own_kickoff)
        goto own_free_kick;
      else if (ball.know_where_itis)
        goto opp_free_kick_go_to_strategy_point;
      else
        stay;
    }
    action {
      search_ball_turning(search_direction = right);
    }
  }

  state opp_free_kick_go_to_strategy_point
  {
     decision 
     {
       if(game.own_kickoff)
         goto own_free_kick;
       else if (action_done)
        goto opp_free_kick_watch_ball;
       else
         stay;
     }
     action {
       head.control_mode = search_for_ball;
       go_to_point_with_USOA(
         x=strategy.position.dynamic.x,
         y=strategy.position.dynamic.y,
         rot=atan2(y = ball.team.position_field.y - strategy.position.dynamic.y, x = ball.team.position_field.x - strategy.position.dynamic.x));
         // ball.team.position_field.x - strategy.position.dynamic.x
         // ball.team.position_field.y - strategy.position.dynamic.y
         // atan2(y = ball.team.position_field.y - strategy.position.dynamic.y, x = ball.team.position_field.x - strategy.position.dynamic.x)
     }
  }

  state opp_free_kick_watch_ball
  {
    decision
    {
      if (!ball.know_where_itis)
        goto decide;
      else if (vector.abs(x=robot_pose.planned.x - strategy.position.dynamic.x, y=robot_pose.planned.y - strategy.position.dynamic.y) > 300)
        goto opp_free_kick_go_to_strategy_point;
      else
        stay;
    }
    
    action
    {
      head.control_mode = search_for_ball;

      motion.type = stand;
    }
  }

  state own_free_kick
  {
    decision {
      if(!game.own_kickoff)
        goto decide;
      else
        stay;
    }
    
    action {
        roles_decide_role();
    }
  }
}

option go_to_and_update_passive_position{

  /** x position of the point to walk to on the field */
 float @x; //[-4500..4500] "mm";

 /** y position of the point to walk to on the field */
 float @y; // [-3000..3000] "mm";

 /** absolute rotation on field */
 float @rot; // -180...180 "deg";

  initial state behave_passive {
    decision {
      if(vector.abs(x=robot_pose.planned.x - @x, y=robot_pose.planned.y - @y) >= 200 || abs(value=robot_pose.planned.rotation - @rot) >= 10)
      {
        if (ball.see_where_itis)
          goto go_with_attention_to_ball;
        else
          goto go_with_search_for_ball;
      }
      else
        stay;
    }
    action {
      passive_behavior();
    }
  }

  state go_with_attention_to_ball {
    decision {
      if(vector.abs(x=robot_pose.planned.x - @x, y=robot_pose.planned.y - @y) < 200 && abs(value=robot_pose.planned.rotation - @rot) < 10)
        goto behave_passive;
      else if (!ball.see_where_itis)
        goto go_with_search_for_ball;
      else
        stay;
    }
    action {
      go_to_point_with_USOA(x=@x, y=@y, rot=@rot);
      
      head.control_mode = look_at_ball;
    }
  }

  state go_with_search_for_ball {
    decision {
      if(vector.abs(x=robot_pose.planned.x - @x, y=robot_pose.planned.y - @y) < 200 && abs(value=robot_pose.planned.rotation - @rot) < 10)
        goto behave_passive;
      else if (ball.see_where_itis)
        goto go_with_attention_to_ball;
      else
        stay;
    }
    action {
      go_to_point_with_USOA(x=@x, y=@y, rot=@rot);
      
      head.control_mode = search_for_ball;
    }
  }
}